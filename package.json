{
  "name": "earnkit",
  "private": true,
  "version": "1.1.0",
  "devDependencies": {
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "turbo": "^1.13.4",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=frontend",
    "build": "turbo run build --filter=frontend",
    "start": "turbo run start --filter=frontend",
    "lint": "turbo run lint --filter=frontend",
    "dev:frontend": "turbo run dev --filter=frontend",
    "build:frontend": "turbo run build --filter=frontend",
    "start:frontend": "turbo run start --filter=frontend",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "preinstall": "node preinstall.js",
    "db:migrate": "tsx apps/frontend/scripts/db-migrate.mts",
    "db:check": "tsx apps/frontend/scripts/db-check.mts",
    "test": "pnpm -s host:typecheck && node apps/frontend/lib/earnkit/fixtures/test-db-template.mjs && tsx --test --import ./apps/frontend/lib/earnkit/fixtures/test-guard.ts \"apps/frontend/lib/**/*.test.ts\" \"infra/host-worker/src/**/*.test.ts\"",
    "host:typecheck": "tsc -p infra/host-worker --noEmit && tsc -p infra/host-worker/tsconfig.test.json --noEmit",
    "programs:sync": "tsx apps/frontend/scripts/programs-sync.mts",
    "predeploy": "pnpm db:migrate && pnpm programs:sync",
    "programs:check": "tsx apps/frontend/scripts/programs-sync.mts --check",
    "feed:rank": "tsx apps/frontend/scripts/feed.mts rank",
    "feed:pin": "tsx apps/frontend/scripts/feed.mts pin",
    "feed:summaries": "tsx apps/frontend/scripts/feed-summaries.mts",
    "feed:hide": "tsx apps/frontend/scripts/feed.mts hide",
    "campaign": "tsx apps/frontend/scripts/campaign.mts",
    "token:e2e": "tsx --tsconfig apps/frontend/tsconfig.json --import ./apps/frontend/lib/earnkit/fixtures/test-guard.ts apps/frontend/scripts/token-e2e.mts",
    "campaign:e2e": "tsx --tsconfig apps/frontend/tsconfig.json --import ./apps/frontend/lib/earnkit/fixtures/test-guard.ts apps/frontend/scripts/campaign-e2e.mts",
    "campaign:fork-check": "tsx --tsconfig apps/frontend/tsconfig.json apps/frontend/scripts/payout-fork-check.mts",
    "bonus:fork-check": "tsx --tsconfig apps/frontend/tsconfig.json apps/frontend/scripts/bonus-fork-check.mts"
  },
  "pnpm": {
    "overrides": {}
  },
  "engines": {
    "node": ">=20.3.0",
    "pnpm": ">=8.0.0",
    "npm": "use-pnpm-instead",
    "yarn": "use-pnpm-instead"
  },
  "packageManager": "pnpm@8.15.9",
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "tsx": "^4.23.15"
  }
}
