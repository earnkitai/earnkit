{
  "name": "earnkit",
  "private": true,
  "version": "1.1.0",
  "devDependencies": {
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "turbo": "^1.13.4",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:dashboard": "turbo run build --filter=dashboard...",
    "build:earnbackend": "pnpm install --prod=false && turbo run build --filter=earn-backend...",
    "build:frontend": "turbo run build --filter=frontend...",
    "dev": "turbo run dev --parallel --filter=dashboard... --filter=earn-backend... --filter=frontend...",
    "dev:dashboard": "turbo run --filter=dashboard... dev",
    "dev:earnbackend": "turbo run --filter=earn-backend... dev",
    "dev:frontend": "turbo run --filter=frontend... dev",
    "start": "turbo run start",
    "start:dashboard": "turbo run --filter=dashboard... start",
    "start:earnbackend": "turbo run --filter=earn-backend... start",
    "start:frontend": "turbo run --filter=frontend start",
    "lint": "turbo run lint",
    "lint:dashboard": "turbo run lint --filter=dashboard...",
    "test": "turbo run test",
    "test:dashboard": "turbo run test --filter=dashboard...",
    "deploy": "turbo run deploy",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "preinstall": "node preinstall.js"
  },
  "pnpm": {
    "overrides": {}
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0",
    "npm": "use-pnpm-instead",
    "yarn": "use-pnpm-instead"
  },
  "packageManager": "pnpm@8.15.9",
  "workspaces": [
    "apps/*"
  ]
}
