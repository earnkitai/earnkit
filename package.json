{
  "name": "earnkit",
  "private": true,
  "version": "1.0.0",
  "devDependencies": {
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "turbo": "^1.13.4",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:backend": "turbo run build --filter=backend...",
    "build:frontend": "turbo run build --filter=frontend...",
    "build:blogs": "turbo run build --filter=blogs...",
    "dev": "turbo run dev --parallel --filter=backend... --filter=frontend... --filter=blogs...",
    "dev:backend": "turbo run dev --filter=backend",
    "dev:frontend": "turbo run --filter=frontend... dev",
    "dev:blogs": "turbo run --filter=blogs... dev",
    "dev:bot": "turbo run --filter=async-multisend-bot dev",
    "start": "turbo run start",
    "start:frontend": "turbo run --filter=frontend start",
    "start:backend": "turbo run start --filter=backend",
    "start:blogs": "turbo run --filter=blogs... start",
    "lint": "turbo run lint",
    "lint:blogs": "turbo run lint --filter=blogs...",
    "test": "turbo run test",
    "test:backend": "turbo run test --filter=backend",
    "test:frontend": "turbo run test --filter=frontend",
    "test:blogs": "turbo run test --filter=blogs...",
    "test:frontend:watch": "turbo run test:watch --filter=frontend",
    "deploy": "turbo run deploy",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "build:railway": "pnpm install && pnpm build:backend",
    "migrate:database": "pnpm --filter backend migrate",
    "migrate:tables": "pnpm --filter backend migrate:tables",
    "migrate:deploy_tokens": "pnpm --filter backend migrate:deploy_tokens",
    "migrate:columns_in_deployed_tokens": "pnpm --filter backend migrate:columns_in_deployed_tokens",
    "preinstall": "node preinstall.js"
  },
  "pnpm": {
    "overrides": {}
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0",
    "npm": "use-pnpm-instead",
    "yarn": "use-pnpm-instead"
  },
  "packageManager": "pnpm@8.15.9",
  "workspaces": [
    "apps/*"
  ]
}
