{
  "name": "earnkit",
  "private": true,
  "version": "1.1.0",
  "devDependencies": {
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "turbo": "^2.9.14",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=frontend",
    "build": "turbo run build --filter=frontend",
    "start": "turbo run start --filter=frontend",
    "lint": "turbo run lint --filter=frontend",
    "dev:frontend": "turbo run dev --filter=frontend",
    "build:frontend": "turbo run build --filter=frontend",
    "start:frontend": "turbo run start --filter=frontend",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "preinstall": "node preinstall.js",
    "db:migrate": "tsx apps/frontend/scripts/db-migrate.mts",
    "db:v4-tables": "tsx apps/frontend/scripts/v4-tables.mts",
    "test": "node apps/frontend/lib/v5/fixtures/test-db-template.mjs && tsx --test --import ./apps/frontend/lib/v5/fixtures/test-guard.ts \"apps/frontend/lib/v5/**/*.test.ts\" \"apps/frontend/lib/v6/**/*.test.ts\"",
    "programs:sync": "tsx apps/frontend/scripts/programs-sync.mts",
    "predeploy": "pnpm db:migrate && pnpm programs:sync",
    "programs:check": "tsx apps/frontend/scripts/programs-sync.mts --check",
    "screen": "tsx apps/frontend/scripts/screen.mts"
  },
  "pnpm": {
    "overrides": {
      "@eslint/plugin-kit@<0.3.4": "^0.3.4",
      "@hono/node-server@>=1.19.10 <2.1.3": "^2.1.3",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "ajv@>=6.0.0 <6.14.0": "^6.14.0",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "flatted@<3.4.2": "^3.4.2",
      "glob@>=10.0.0 <14.0.2": "^14.0.2",
      "hono@<4.13.11": "^4.13.11",
      "ip-address@<10.7.4": "^10.7.4",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "minimatch@>=10.0.0 <11.0.1": "^11.0.1",
      "nanoid@<3.3.18": "^3.3.18",
      "picomatch@<2.3.2": "^2.3.2",
      "postcss@<8.5.23": "^8.5.23",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "qs@>=6.7.0 <6.16.1": "^6.16.1",
      "source-map-js@<1.2.2": "^1.2.2",
      "yaml@>=2.0.0 <2.8.3": "^2.8.3"
    }
  },
  "engines": {
    "node": ">=20.3.0",
    "pnpm": ">=8.0.0",
    "npm": "use-pnpm-instead",
    "yarn": "use-pnpm-instead"
  },
  "packageManager": "pnpm@8.15.9",
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "license": "MIT OR Apache-2.0"
}
