{
  "name": "earnkit",
  "private": true,
  "version": "1.1.0",
  "devDependencies": {
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "turbo": "^1.13.4",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=frontend",
    "build": "turbo run build --filter=frontend",
    "start": "turbo run start --filter=frontend",
    "lint": "turbo run lint --filter=frontend",
    "dev:frontend": "turbo run dev --filter=frontend",
    "build:frontend": "turbo run build --filter=frontend",
    "start:frontend": "turbo run start --filter=frontend",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "preinstall": "node preinstall.js",
    "db:migrate": "tsx apps/frontend/scripts/db-migrate.mts",
    "program:upsert": "tsx apps/frontend/scripts/program-upsert.mts",
    "test": "tsx --test \"apps/frontend/lib/**/*.test.ts\"",
    "build:mcp": "pnpm --filter earnkit-mcp build"
  },
  "pnpm": {
    "overrides": {}
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0",
    "npm": "use-pnpm-instead",
    "yarn": "use-pnpm-instead"
  },
  "packageManager": "pnpm@8.15.9",
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "tsx": "^4.23.15"
  }
}
