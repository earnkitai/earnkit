generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String          @id @unique
  username            String?         @unique
  email               String?         @unique
  createdAt           DateTime        @default(now()) @map("created_at")
  hasAcceptedTerms    Boolean         @default(false) @map("has_accepted_terms")
  isGuest             Boolean         @default(false) @map("is_guest")
  mfaMethods          String[]        @default([]) @map("mfa_methods")
  apiKey              String?         @unique @map("api_key")        // stores SHA-256 hash
  apiKeyPrefix        String?         @map("api_key_prefix")         // e.g. "ek_abcd1234"
  agents              Agent[]
  walletAccounts      WalletAccount[]

  @@map("users")
}

model WalletAccount {
  id               String  @id @default(uuid())
  userId           String  @map("user_id")
  type             String  @default("wallet")
  address          String
  chainType        String  @map("chain_type")
  walletClientType String  @map("wallet_client_type")
  connectorType    String  @map("connector_type")
  recoveryMethod   String  @map("recovery_method")
  imported         Boolean @default(false)
  delegated        Boolean @default(false)
  walletIndex      Int?    @map("wallet_index")
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallet_accounts")
}

model Agent {
  id                  String             @id @default(uuid())
  userId              String             @map("user_id")
  name                String
  agentId             String             @unique @map("agent_id")
  status              AgentStatus        @default(ACTIVE)
  feeModel            FeeModel           @default(FREE_TIER)
  freePromptThreshold Int?               @map("free_prompt_threshold")
  ratePerPrompt       Float?             @map("rate_per_prompt")
  creditsPerPrompt    Int?               @map("credits_per_prompt")
  totalEarnings       Float              @default(0) @map("total_earnings")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  topUpPackages       TopUpPackage[]
  topUpTransactions   TopUpTransaction[]
  transactionLogs     TransactionLog[]
  usageEvents         UsageEvent[]
  userBalances        UserBalance[]
  tokenConfigs        AgentTokenConfig[]
  paymentIntents      PaymentIntent[]
  ledgerEntries       LedgerEntry[]
  giftCodes           GiftCode[]
  buybackConfig       BuybackConfig?
  splitAddress        String?            @map("split_address")
  buybackAddress      String?            @map("buyback_address")
  buybackPercent      Float              @default(0) @map("buyback_percent")

  @@index([userId])
  @@index([agentId])
  @@index([status])
  @@index([createdAt])
  @@index([splitAddress])
  @@map("agents")
}

model GiftCode {
  id                   String               @id @default(cuid())
  code                 String               @unique
  agentId              String               @map("agent_id")
  creditsPerRedemption Int                  @map("credits_per_redemption")
  maxRedemptions       Int?                 @map("max_redemptions")
  redemptionCount      Int                  @default(0) @map("redemption_count")
  isActive             Boolean              @default(true) @map("is_active")
  expiresAt            DateTime?            @map("expires_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  agent                Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  redemptions          GiftCodeRedemption[]

  @@index([agentId])
  @@index([code])
  @@map("gift_codes")
}

model GiftCodeRedemption {
  id                String   @id @default(cuid())
  giftCodeId        String   @map("gift_code_id")
  userWalletAddress String   @map("user_wallet_address")
  creditsAdded      Int      @map("credits_added")
  redeemedAt        DateTime @default(now()) @map("redeemed_at")
  giftCode          GiftCode @relation(fields: [giftCodeId], references: [id], onDelete: Cascade)

  @@unique([giftCodeId, userWalletAddress])
  @@index([giftCodeId])
  @@index([userWalletAddress])
  @@map("gift_code_redemptions")
}

model BuybackConfig {
  id                String             @id @default(cuid())
  agentId           String             @unique @map("agent_id")
  agent             Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // The user's chosen ERC-20 to buy back & burn (must live on Base, must pass safety pre-checks).
  tokenAddress      String             @map("token_address")
  tokenSymbol       String             @map("token_symbol")
  tokenDecimals     Int                @map("token_decimals")

  thresholdUsd      Float              @default(10) @map("threshold_usd")
  // Slippage tolerance in basis points; 150 = 1.5%. UI clamps 100..2000 (1%..20%).
  slippageBps       Int                @default(150) @map("slippage_bps")
  burnMode          BurnMode           @default(DEAD_ADDRESS) @map("burn_mode")

  // Turnkey identifiers — sub-org root is the end user, not us.
  turnkeySubOrgId   String             @unique @map("turnkey_sub_org_id")
  turnkeyWalletId   String             @unique @map("turnkey_wallet_id")
  walletAddress     String             @unique @map("wallet_address")
  policyId          String             @map("policy_id")
  // EOA the "Recover stranded funds" flow sweeps to. Set at creation = the
  // user's connected dev wallet. Bound into the Turnkey policy so the platform
  // can sign sweeps without the user having to use their root credential.
  recoveryAddress   String             @map("recovery_address")
  // Reserved for future per-config co-signer routing. v1 reads BUYBACK_COSIGNER_URL
  // for all configs; this column lets us migrate to per-tenant co-signers later
  // without another schema change. Null = use the env default.
  coSignerEndpoint  String?            @map("co_signer_endpoint")

  isActive          Boolean            @default(true) @map("is_active")
  lastCheckedAt     DateTime?          @map("last_checked_at")
  lastTriggeredAt   DateTime?          @map("last_triggered_at")

  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  executions        BuybackExecution[]

  @@index([isActive])
  @@index([walletAddress])
  @@map("buyback_configs")
}

model BuybackExecution {
  id                      String         @id @default(cuid())
  buybackConfigId         String         @map("buyback_config_id")
  buybackConfig           BuybackConfig  @relation(fields: [buybackConfigId], references: [id], onDelete: Cascade)

  status                  BuybackStatus  @default(QUEUED)
  triggerBalanceUsd       Float          @map("trigger_balance_usd")
  attempts                Int            @default(0)
  lastError               String?        @map("last_error")
  nextAttemptAt           DateTime?      @map("next_attempt_at")

  // Per-step tx hashes — one row covers the full withdraw → swap → burn chain.
  warehouseWithdrawHashes String[]       @default([]) @map("warehouse_withdraw_hashes")
  swapHash                String?        @map("swap_hash")
  burnHash                String?        @map("burn_hash")

  // Accounting snapshot captured when the execution starts.
  // assetsIn = [{ symbol, address, amount, usdValue }] — JSON for flexibility.
  assetsIn                Json?          @map("assets_in")
  tokensOutAmount         String?        @map("tokens_out_amount")
  tokensOutUsd            Float?         @map("tokens_out_usd")
  gasSpentEth             String?        @map("gas_spent_eth")

  startedAt               DateTime       @default(now()) @map("started_at")
  // Set each time a worker claims the row into a transitional state. Lets the
  // reaper detect a row wedged in WITHDRAWING/SWAPPING/BURNING by a crashed
  // worker (started_at is unreliable — it never moves across retries).
  claimedAt               DateTime?      @map("claimed_at")
  completedAt             DateTime?      @map("completed_at")

  @@index([buybackConfigId, status])
  @@index([status, nextAttemptAt])
  @@map("buyback_executions")
}

enum BurnMode {
  DEAD_ADDRESS
  TOKEN_BURN_FN
}

enum BuybackStatus {
  QUEUED
  WITHDRAWING
  SWAPPING
  BURNING
  COMPLETED
  FAILED
  RETRYING
}

model AgentTokenConfig {
  id              String   @id @default(uuid())
  agentId         String   @map("agent_id")
  tokenAddress    String   @map("token_address") // "eth" for ETH, contract address for tokens
  tokenSymbol     String   @map("token_symbol")
  enabled         Boolean  @default(true)
  discountPercent Float    @default(0) @map("discount_percent") // e.g., 10 = 10% discount
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, tokenAddress])
  @@index([agentId])
  @@index([tokenAddress])
  @@map("agent_token_configs")
}

model TopUpPackage {
  id        String   @id @default(uuid())
  agentId   String   @map("agent_id")
  name      String
  credits   Int
  price     Float
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([isActive])
  @@map("top_up_packages")
}

model TransactionLog {
  id              String            @id @default(uuid())
  agentId         String            @map("agent_id")
  userId          String            @map("user_id")
  transactionHash String?           @map("transaction_hash")
  fromAddress     String            @map("from_address")
  toAddress       String            @map("to_address")
  amount          Float
  status          TransactionStatus @default(PENDING)
  transactionType TransactionType
  description     String?
  metadata        Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  agent           Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([userId])
  @@index([status])
  @@index([transactionType])
  @@index([createdAt])
  @@map("transaction_logs")
}

model UserBalance {
  userWalletAddress String
  agentId           String
  ethBalance        Decimal  @default(0)
  creditBalance     BigInt   @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([userWalletAddress, agentId])
  @@map("user_balances")
}

model UsageEvent {
  id                String           @id @default(cuid())
  status            UsageEventStatus @default(PENDING)
  feeDeducted       Decimal?
  creditsDeducted   BigInt?
  idempotencyKey    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  agentId           String
  userWalletAddress String
  agent             Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, idempotencyKey])
  @@index([agentId, userWalletAddress, status])
  @@map("usage_events")
}

model TopUpTransaction {
  txHash            String      @id
  status            TopUpStatus @default(PENDING)
  userWalletAddress String
  agentId           String
  amountInUSD       String      @map("amount_in_usd") @default("0")
  amountInEth       String      @map("amount_in_eth") @default("0")
  creditsToTopUp    BigInt?
  errorMessage      String?
  attemptCount      Int         @default(0) @map("attempt_count")
  nextAttemptAt     DateTime?   @map("next_attempt_at")
  // Token-specific fields (null = ETH payment)
  tokenAddress      String?     @map("token_address")
  tokenSymbol       String?     @map("token_symbol")
  amountInToken     String?     @map("amount_in_token")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  agent             Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([tokenAddress])
  @@map("top_up_transactions")
}

model PaymentIntent {
  id                    String              @id @default(cuid())
  agentId               String              @map("agent_id")
  clientSecret          String              @unique @map("client_secret")
  externalReference     String?             @map("external_reference")
  status                PaymentIntentStatus @default(CREATED)
  customerWalletAddress String?             @map("customer_wallet_address")
  amountInUSD           Decimal?            @map("amount_in_usd")
  creditsToTopUp        BigInt?             @map("credits_to_top_up")
  paymentMethodType     PaymentMethodType   @default(ETH) @map("payment_method_type")
  tokenAddress          String?             @map("token_address")
  tokenSymbol           String?             @map("token_symbol")
  amountAtomic          String              @map("amount_atomic")
  chainId               Int                 @map("chain_id")
  txHash                String?             @unique @map("tx_hash")
  metadata              Json?
  expiresAt             DateTime?           @map("expires_at")
  confirmedAt           DateTime?           @map("confirmed_at")
  cancelledAt           DateTime?           @map("cancelled_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  agent                 Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  ledgerEntries         LedgerEntry[]

  @@index([agentId, status])
  @@index([customerWalletAddress])
  @@index([txHash])
  @@index([createdAt])
  @@map("payment_intents")
}

model LedgerEntry {
  id                    String            @id @default(cuid())
  agentId               String            @map("agent_id")
  paymentIntentId       String?           @map("payment_intent_id")
  userWalletAddress     String?           @map("user_wallet_address")
  entryType             LedgerEntryType   @map("entry_type")
  status                LedgerEntryStatus @default(PENDING)
  amountInUSD           Decimal?          @map("amount_in_usd")
  credits               BigInt?
  paymentMethodType     PaymentMethodType @default(ETH) @map("payment_method_type")
  tokenAddress          String?           @map("token_address")
  tokenSymbol           String?           @map("token_symbol")
  amountAtomic          String?           @map("amount_atomic")
  chainId               Int?              @map("chain_id")
  txHash                String?           @map("tx_hash")
  idempotencyKey        String?           @map("idempotency_key")
  metadata              Json?
  createdAt             DateTime          @default(now()) @map("created_at")
  agent                 Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  paymentIntent         PaymentIntent?    @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@unique([agentId, idempotencyKey])
  @@index([agentId, entryType])
  @@index([paymentIntentId])
  @@index([txHash])
  @@index([createdAt])
  @@map("ledger_entries")
}

enum AgentStatus {
  ACTIVE
  PAUSED
  DELETED
}

enum FeeModel {
  FREE_TIER
  CREDIT_BASED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum TransactionType {
  EARNING
  WITHDRAWAL
  TOP_UP
  REFUND
}

enum UsageEventStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  INSUFFICIENT_CREDITS
}

enum TopUpStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentIntentStatus {
  CREATED
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentMethodType {
  ETH
  ERC20
}

enum LedgerEntryType {
  PAYMENT_INTENT_CREATED
  PAYMENT_RECEIVED
  CREDIT_GRANTED
  USAGE_RESERVED
  USAGE_CAPTURED
  USAGE_RELEASED
  REFUND
  WITHDRAWAL
  FEE
}

enum LedgerEntryStatus {
  PENDING
  POSTED
  REVERSED
  FAILED
}

model SharedSplitBuybackConfig {
  id              String   @id @default(cuid())

  ownerAddress    String   @map("owner_address")
  // Nullable: in the deferred-register flow (Token card → we deploy the split
  // after Turnkey provisioning), splitAddress is populated by /:id/set-split
  // once the user's deploy tx confirms. For the Splits card flow it's set at
  // registration time.
  splitAddress    String?  @map("split_address")
  tokenAddress    String   @map("token_address")
  tokenSymbol     String   @map("token_symbol")
  tokenDecimals   Int      @map("token_decimals")

  feeRateBps      Int      @default(100)  @map("fee_rate_bps")
  thresholdUsd    Float    @default(10)   @map("threshold_usd")
  slippageBps     Int      @default(150)  @map("slippage_bps")
  burnMode        BurnMode @default(DEAD_ADDRESS) @map("burn_mode")

  turnkeySubOrgId    String?  @unique @map("turnkey_sub_org_id")
  turnkeyWalletId    String?  @unique @map("turnkey_wallet_id")
  walletAddress      String?  @unique @map("wallet_address")
  policyId           String?  @map("policy_id")
  recoveryAddress    String   @map("recovery_address")
  // Sub-org-local user IDs for the two stampers — stored at wallet-provision
  // time so Phase 2 (policy attachment) can reference them without a Turnkey
  // re-query. Only populated for the two-phase token creation flow.
  parentAdminUserId  String?  @map("parent_admin_user_id")
  coSignerUserId     String?  @map("co_signer_user_id")

  // Phase 2 (activation) telemetry. Activation can fail transiently (RPC
  // hiccup, token-safety probe edge cases, Turnkey timeout). We persist the
  // last attempt's outcome here so:
  //   (a) the admin UI can show the creator WHY their buyback is stuck
  //   (b) the worker has a deterministic retry surface
  //   (c) the SLA dashboard can count stuck configs
  lastActivationError      String?   @map("last_activation_error")
  lastActivationAttemptAt  DateTime? @map("last_activation_attempt_at")
  activationAttempts       Int       @default(0) @map("activation_attempts")

  // Pending token address — set at Phase 2 attempt time even if the policy
  // attach fails, so the worker's retry loop knows what token to bind the
  // policy to without needing a re-call from tokens.fun.
  pendingTokenAddress      String?   @map("pending_token_address")

  // Swap venue selection. Doppler tokens trade on Uniswap V4 multicurve via
  // RehypeDopplerHook; legacy tokens trade on V3. The worker branches on this
  // to construct the correct swap calldata + the policy is built to
  // authorize the matching router. Defaults to V3 for backward compatibility
  // with existing agent buyback flows.
  swapVenue                String    @default("UNISWAP_V3") @map("swap_venue")

  // V4-only pool info (mirrors what tokens.fun /api/pool-key returns).
  // Populated by tokens.fun at activation time. Null for V3 configs.
  v4PoolHook         String?  @map("v4_pool_hook")
  v4PairedToken      String?  @map("v4_paired_token")
  v4TickSpacing      Int?     @map("v4_tick_spacing")
  v4FeeFlag          Int?     @map("v4_fee_flag")

  status          SharedSplitStatus @default(PROVISIONING)

  isActive        Boolean   @default(true)  @map("is_active")
  lastCheckedAt   DateTime? @map("last_checked_at")
  lastTriggeredAt DateTime? @map("last_triggered_at")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt      @map("updated_at")
  executions      SharedSplitExecution[]

  @@index([status])
  @@index([walletAddress])
  @@map("shared_split_buyback_configs")
}

model SharedSplitExecution {
  id        String                    @id @default(cuid())
  configId  String                    @map("config_id")
  config    SharedSplitBuybackConfig  @relation(fields: [configId], references: [id], onDelete: Cascade)

  status            BuybackStatus @default(QUEUED)
  triggerBalanceUsd Float         @map("trigger_balance_usd")
  attempts          Int           @default(0)
  lastError         String?       @map("last_error")
  nextAttemptAt     DateTime?     @map("next_attempt_at")

  warehouseWithdrawHashes String[] @default([]) @map("warehouse_withdraw_hashes")
  feeTransferHashes       String[] @default([]) @map("fee_transfer_hashes")
  swapHash                String?  @map("swap_hash")
  burnHash                String?  @map("burn_hash")

  assetsIn        Json?    @map("assets_in")
  feeCollectedUsd Float?   @map("fee_collected_usd")
  tokensOutAmount String?  @map("tokens_out_amount")
  tokensOutUsd    Float?   @map("tokens_out_usd")

  startedAt   DateTime  @default(now()) @map("started_at")
  // Set each time a worker claims the row into a transitional state — see the
  // reaper note on BuybackExecution.claimedAt.
  claimedAt   DateTime? @map("claimed_at")
  completedAt DateTime? @map("completed_at")

  @@index([configId, status])
  @@index([status, nextAttemptAt])
  @@map("shared_split_executions")
}

enum SharedSplitStatus {
  PROVISIONING
  PENDING_SPLIT_UPDATE
  ACTIVE
  PAUSED
  BROKEN
}

// TokenContractBuybackConfig, TokenContractExecution, TokenContractStatus
// removed: the legacy single-recipient token-buyback flow is superseded by
// the unified split-based flow on SharedSplitBuybackConfig (Token card on
// /create now deploys a 0xSplits contract per launch).
//
// Privy linked-account mirror tables (apple/google/twitter/discord/github/
// spotify/instagram/tiktok/linkedin/farcaster/telegram/phone/email/passkey/
// custom_jwt/smart_wallet accounts, cross_app_accounts, embedded_wallets,
// smart_wallets) removed: they were never written and the dashboard reads
// linked accounts directly from the Privy SDK. Only wallet_accounts is kept.
//
// Webhook tables (webhook_endpoints, webhook_deliveries) removed along with
// the unadopted outbound-webhook feature.
