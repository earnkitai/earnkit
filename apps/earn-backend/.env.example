# ─── Database ─────────────────────────────────────────────────────────────────
# Railway: use ${{Postgres.DATABASE_URL}} reference, or paste the internal URL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins (your dashboard URL)
# Leave empty to block all browser requests (server-to-server only)
CORS_ALLOWED_ORIGINS=https://your-dashboard.vercel.app

# ─── Base Network ─────────────────────────────────────────────────────────────
# Used by viem to verify on-chain transactions
# Get from: alchemy.com → Create App → Base Mainnet → copy HTTPS URL
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Returned to SDK clients as network config
RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
CHAIN_ID=8453
NETWORK_NAME=Base

# ─── Legacy Escrow Contract ───────────────────────────────────────────────────
# Keep this until all legacy agents (created before Splits) drain their balances
ESCROW_CONTRACT_ADDRESS=0xCAeB6A62D04C52E1e196E5Bdce63e43f45582aA2

# ─── Splits Protocol ──────────────────────────────────────────────────────────
# Hot wallet used to deploy SplitV2 contracts when an agent is created
# Only needs ~0.02 ETH on Base for gas — never holds user funds
# Generate: cast wallet new  OR  MetaMask → Create Account → Export Private Key
SPLITS_DEPLOYER_PRIVATE_KEY=0x

# Your treasury wallet address — receives 5% of every payment automatically
PLATFORM_FEE_WALLET=0x

# ─── Internal API Secret ──────────────────────────────────────────────────────
# Shared secret between dashboard and earn-backend for the deploy-split route
# Must match INTERNAL_API_SECRET in the dashboard service
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# ─── Price Services ───────────────────────────────────────────────────────────
# Used to convert ETH/token amounts to USD for credit calculation
# Get from: alchemy.com → Apps → API Keys (just the key, not the full URL)
ALCHEMY_API_KEY=

# Get from: coingecko.com/en/api → Get API Key → free Demo plan works
COINGECKO_API_KEY=

# ─── Admin ────────────────────────────────────────────────────────────────────
# Protects /api/debug routes — any string you choose
ADMIN_API_KEY=
