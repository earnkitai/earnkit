{
  "name": "earn-backend",
  "version": "1.0.0",
  "description": "EarnKit Backend API for monetization platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema=src/prisma/schema.prisma && tsc",
    "start": "prisma migrate deploy --schema=src/prisma/schema.prisma && node dist/index.js",
    "test": "jest",
    "db:generate": "prisma generate --schema=src/prisma/schema.prisma",
    "db:push": "prisma db push --schema=src/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=src/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=src/prisma/schema.prisma",
    "db:init": "tsx src/scripts/initDb.ts",
    "postinstall": "prisma generate --schema=src/prisma/schema.prisma",
    "compile": "hardhat compile",
    "clean": "hardhat clean"
  },
  "keywords": [
    "earnkit",
    "monetization",
    "api",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@0xsplits/splits-sdk": "^6.0.0",
    "@noble/curves": "^2.2.0",
    "@prisma/client": "^5.7.0",
    "@privy-io/server-auth": "^1.21.0",
    "@turnkey/sdk-server": "^2.6.1",
    "cors": "^2.8.5",
    "cuid": "^3.0.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.8.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "hardhat": "^2.19.0",
    "jest": "^29.7.0",
    "prisma": "^5.7.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
