// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @unique // This will be the privyId
  username            String?   @unique
  email               String?   @unique
  createdAt           DateTime  @default(now()) @map("created_at")
  hasAcceptedTerms    Boolean   @default(false) @map("has_accepted_terms")
  isGuest             Boolean   @default(false) @map("is_guest")
  mfaMethods          String[]  @default([]) @map("mfa_methods")
  
  // Linked Accounts - will be empty arrays if no accounts are linked
  walletAccounts      WalletAccount[]
  smartWalletAccounts SmartWalletAccount[]
  emailAccounts       EmailAccount[]
  phoneAccounts       PhoneAccount[]
  googleAccounts      GoogleAccount[]
  twitterAccounts     TwitterAccount[]
  discordAccounts     DiscordAccount[]
  githubAccounts      GithubAccount[]
  spotifyAccounts     SpotifyAccount[]
  instagramAccounts   InstagramAccount[]
  tiktokAccounts      TiktokAccount[]
  linkedinAccounts    LinkedInAccount[]
  appleAccounts       AppleAccount[]
  customJwtAccounts   CustomJwtAccount[]
  farcasterAccounts   FarcasterAccount[]
  passkeyAccounts     PasskeyAccount[]
  telegramAccounts    TelegramAccount[]
  crossAppAccounts    CrossAppAccount[]

  // Chats
  chats               Chat[]

  @@map("users")
}

// Linked Account Models
model WalletAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("wallet")
  address         String
  chainType       String    @map("chain_type")
  walletClientType String   @map("wallet_client_type")
  connectorType   String    @map("connector_type")
  recoveryMethod  String    @map("recovery_method")
  imported        Boolean   @default(false)
  delegated       Boolean   @default(false)
  walletIndex     Int?      @map("wallet_index")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallet_accounts")
}

model SmartWalletAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("smart_wallet")
  address         String
  smartWalletType String    @map("smart_wallet_type")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("smart_wallet_accounts")
}

model EmailAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("email")
  address         String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_accounts")
}

model PhoneAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("phone")
  number          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("phone_accounts")
}

model GoogleAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("google_oauth")
  subject         String
  email           String
  name            String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_accounts")
}

model TwitterAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("twitter_oauth")
  subject         String
  username        String?
  name            String?
  profilePictureUrl String? @map("profile_picture_url")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twitter_accounts")
}

model DiscordAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("discord_oauth")
  subject         String
  username        String?
  email           String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("discord_accounts")
}

model GithubAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("github_oauth")
  subject         String
  username        String?
  name            String?
  email           String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("github_accounts")
}

model SpotifyAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("spotify_oauth")
  subject         String
  email           String?
  name            String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("spotify_accounts")
}

model InstagramAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("instagram_oauth")
  subject         String
  username        String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("instagram_accounts")
}

model TiktokAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("tiktok_oauth")
  subject         String
  username        String?
  name            String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tiktok_accounts")
}

model LinkedInAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("linkedin_oauth")
  subject         String
  name            String?
  email           String?
  vanityName      String?   @map("vanity_name")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("linkedin_accounts")
}

model AppleAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("apple_oauth")
  subject         String
  email           String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("apple_accounts")
}

model CustomJwtAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("custom_auth")
  customUserId    String    @map("custom_user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("custom_jwt_accounts")
}

model FarcasterAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("farcaster")
  fid             Int?
  ownerAddress    String    @map("owner_address")
  username        String?
  displayName     String?   @map("display_name")
  bio             String?
  pfp             String?
  url             String?
  signerPublicKey String?   @map("signer_public_key")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("farcaster_accounts")
}

model PasskeyAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("passkey")
  credentialId    String    @map("credential_id")
  enrolledInMfa   Boolean   @default(false) @map("enrolled_in_mfa")
  authenticatorName String  @map("authenticator_name")
  createdWithDevice String  @map("created_with_device")
  createdWithOs    String   @map("created_with_os")
  createdWithBrowser String @map("created_with_browser")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passkey_accounts")
}

model TelegramAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("telegram")
  telegramUserId  String    @map("telegram_user_id")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  username        String?
  photoUrl        String?   @map("photo_url")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_accounts")
}

model CrossAppAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    @default("cross_app")
  subject         String
  providerApp     Json      @map("provider_app")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  embeddedWallets EmbeddedWallet[]
  smartWallets    SmartWallet[]

  @@map("cross_app_accounts")
}

model EmbeddedWallet {
  id              String    @id @default(uuid())
  crossAppAccountId String  @map("cross_app_account_id")
  address         String
  crossAppAccount CrossAppAccount @relation(fields: [crossAppAccountId], references: [id], onDelete: Cascade)

  @@map("embedded_wallets")
}

model SmartWallet {
  id              String    @id @default(uuid())
  crossAppAccountId String  @map("cross_app_account_id")
  address         String
  crossAppAccount CrossAppAccount @relation(fields: [crossAppAccountId], references: [id], onDelete: Cascade)

  @@map("smart_wallets")
}

model Chat {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@map("chats")
}

model Message {
  id          String    @id @default(uuid())
  chatId      String    @map("chat_id")
  responseFrom String   @map("response_from")
  toolName    String?   @map("tool_name")
  content     String
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  chat        Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("messages")
}
