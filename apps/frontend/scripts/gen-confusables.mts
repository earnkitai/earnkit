/**
 * Generates lib/earnkit/confusables-table.ts from Unicode UTS #39 confusables.txt: every non-ASCII
 * character whose prototype is ASCII letters or digits (e.g. Cyrillic "а" -> "a", "ɑ" -> "a"), or a
 * full stop (Lisu "ꓸ" -> ".", read as a dot before link detection).
 *
 *   tsx apps/frontend/scripts/gen-confusables.mts [path/to/confusables.txt]
 *
 * Without a path it downloads https://www.unicode.org/Public/security/latest/confusables.txt.
 * Re-run when Unicode publishes a new version, then run the tests (confusables.test.ts).
 */
import { readFileSync, writeFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const URL_ = 'https://www.unicode.org/Public/security/latest/confusables.txt';
const path = process.argv[2];
const text = path
  ? readFileSync(path, 'utf8')
  : await (await fetch(URL_)).text();

const version = /^# Version: (\S+)/m.exec(text)?.[1];
const date = /^# Date: ([^,\n]+)/m.exec(text)?.[1];
if (!version) throw new Error('No "# Version:" line: not confusables.txt?');

const hex = (s: string) =>
  s
    .trim()
    .split(/\s+/)
    .map((h) => String.fromCodePoint(parseInt(h, 16)))
    .join('');

const map: [string, string][] = [];
for (const line of text.split('\n')) {
  const m = /^([0-9A-F]+)\s*;\s*([0-9A-F ]+?)\s*;/.exec(line);
  if (!m) continue;
  const source = hex(m[1]);
  const target = hex(m[2]);
  // ASCII sources (1 -> l, m -> rn, ...) are left to confusables.ts; only look-alikes of letters,
  // digits and the full stop are kept.
  if (/^[\x00-\x7f]$/.test(source) || !/^(?:[A-Za-z0-9]+|\.)$/.test(target))
    continue;
  map.push([source, target]);
}
map.sort(([a], [b]) => a.codePointAt(0)! - b.codePointAt(0)!);

const esc = (s: string) =>
  [...s].map((c) => `\\u{${c.codePointAt(0)!.toString(16)}}`).join('');
const out = `// Generated by apps/frontend/scripts/gen-confusables.mts from Unicode confusables.txt
// version ${version} (${date}). Do not edit by hand; re-run the script.
// ${map.length} non-ASCII characters whose UTS #39 prototype is ASCII letters, digits or ".".

export const CONFUSABLES_VERSION = '${version}';

/** "source<tab>target" pairs, one per line. */
const PAIRS = \`
${map.map(([s, t]) => `${esc(s)}\\t${t}`).join('\n')}
\`;

/** Non-ASCII character -> the ASCII letters, digits or "." it can pass for (case as in Unicode). */
export const CONFUSABLES: ReadonlyMap<string, string> = new Map(
  PAIRS.trim()
    .split('\\n')
    .map((l) => l.split('\\t') as [string, string]),
);
`;
const dest = fileURLToPath(
  new URL('../lib/earnkit/confusables-table.ts', import.meta.url),
);
writeFileSync(dest, out);
console.log(
  `Wrote ${map.length} mappings (confusables.txt ${version}) to ${dest}`,
);
